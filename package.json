{
  "name": "spartito-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Turn ChordPro lyrics and chords into one-page A4 PDFs for tablet use.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedetamburlin/spartito.git"
  },
  "homepage": "https://fedetamburlin.github.io/spartito/",
  "bugs": {
    "url": "https://github.com/fedetamburlin/spartito/issues"
  },
  "engines": {
    "node": "^22.12 || >=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "fixtures:sync": "node scripts/fetch-fixtures.mjs",
    "fixtures:check": "node scripts/fetch-fixtures.mjs --check",
    "fixtures:pdf": "node scripts/make-pdf-fixtures.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run check && npm test && npm run test:e2e && npm run mcp:check && npm run mcp:test && npm run mcp:build",
    "mcp:build": "npm run build -w spartito-mcp",
    "mcp:check": "npm run check -w spartito-mcp",
    "mcp:test": "npm run test -w spartito-mcp"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "unpdf": "1.9.1"
  }
}
