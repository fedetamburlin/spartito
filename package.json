{
  "name": "spartito-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal editor to create A4 PDF song sheets (lyrics + chords) to read on a tablet",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "mcp:build": "npm run build -w spartito-mcp",
    "mcp:check": "npm run check -w spartito-mcp",
    "mcp:test": "npm run test -w spartito-mcp"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^18.19.130",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "unpdf": "1.7.0"
  }
}
